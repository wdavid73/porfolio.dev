---
import ExperienceItem from "./ExperienceItem.astro";
const EXPERIENCE = [
  {
    date: "Agosto 2025 - Actualmente",
    title: "Senior Flutter Developer",
    company: "Commodo",
    description: `Desarrollo y mantenimiento de 3 apps multiplataforma (Android/iOS) con ~100K usuarios activos, usando Clean Architecture, MVVM y un monorepo por features. Ajusté el código y la experiencia de usuario de la app, incluidos sus flujos de pago y el sistema de fidelización con animaciones. Lideré una refactorización con Riverpod que redujo la complejidad del código en ~30%, y automaticé los pipelines de CI/CD con GitHub Actions y Fastlane, bajando el ciclo de release en 40%. Integré pruebas con Patrol y Firebase Test Lab, y notificaciones push, deep linking y monitoreo de rendimiento.`,
  },
  {
    date: "Octubre 2021 - Agosto 2025",
    title: "Flutter & Frontend Developer",
    company: "Guane Enterprises",
    description: `Desarrollé productos móviles y web para más de 5 clientes empresariales en energía, fintech y PaaS, con Flutter, Vue.js y React.js. Participé en una plataforma de medición y pronóstico de energía con un equipo de más de 10 personas, con registro en tiempo real de más de 100 puntos de medición y pronósticos generados con IA. Mejoré en 25% los tiempos de carga de una app financiera en Flutter y establecí estándares de Clean Architecture y BLoC/Riverpod para el equipo, reduciendo en ~20% los bugs de integración.`,
  },
  {
    date: "Abril 2021 - Octubre 2021",
    title: "Software Developer",
    company: "Naowee S.A.S",
    description: `Desarrollé una solución full-stack con Laravel, Vue.js 2 y MySQL, que incluyó el diseño de la API REST y la arquitectura de base de datos. Implementé 5 endpoints nuevos en Laravel e integré la API de Google Maps Distance Matrix para calcular distancias por geolocalización. También refactoricé componentes de Vue.js para mejorar su mantenibilidad.`,
  },
];
---

<ol class="relative mt-16">
  {
    EXPERIENCE.map((experience) => (
      <li class="">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
