---
import ExperienceItem from "./ExperienceItem.astro";
const EXPERIENCE = [
  {
    date: "Actualmente...",
    title: "Mobile Developer",
    company: "Commodo",
    description: `Como Desarrollador Mobile en Commodo, he creado aplicaciones 
    multiplataforma con Flutter y Dart, aplicando arquitecturas escalables como 
    MVVM y Clean Architecture. He integrado APIs y SDKs de terceros, y diseñado 
    interfaces enfocadas en la experiencia del usuario. Además, he colaborado en 
    equipos ágiles bajo metodología Scrum, participando en la planificación y mejora 
    continua del proceso de desarrollo.`,
  },
  {
    date: "Octubre 2021 - Agosto 2025",
    title: "FrontEnd Developer",
    company: "Guane enterprise",
    description: `Especializado en Vue.js y React.js, desarrollo y mantengo interfaces de usuario, 
    colaborando en mejoras UX y aplicando buenas prácticas de diseño. 
    He integrado APIs y creado un panel en tiempo real con WebSocket. Actualmente, 
    lidero el frontend de una app financiera en Flutter, 
    mejorando continuamente su rendimiento y gestionando pruebas internas con Firebase.`,
  },
  {
    date: "Abril 2021 - Octubre 2021",
    title: "Software Developer",
    company: "Naowee S.A.S",
    description: `Trabajé en el desarrollo y soporte de una plataforma de citas médicas utilizando Laravel, 
    donde creé endpoints, gestioné bases de datos y desarrollé interfaces de usuario. 
    En otro proyecto, diseñé y desarrollé una plataforma de viajes tipo Uber para España, 
    encargándome de la arquitectura completa, incluyendo frontend (Vue.js), backend (Laravel), 
    base de datos (MySQL), y chat interactivo (Firestore).`,
  },
];
---

<ol class="relative mt-16">
  {
    EXPERIENCE.map((experience) => (
      <li class="">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
