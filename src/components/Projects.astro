---
import GitHub from "./icons/GitHub.astro";
import LinkButton from "./LinkButton.astro";
import Flutter from "./icons/Flutter.astro";
import Django from "./icons/Django.astro";
import React from "./icons/React.astro";
import Vue from "./icons/Vue.astro";
import Android from "./icons/Android.astro";
import Link from "./icons/Link.astro";
import Code from "./icons/Code.astro";
import Firebase from "./icons/Firebase.astro";
import Supabase from "./icons/Supabase.astro";

const TAGS = {
  FLUTTER: {
    name: "Flutter",
    class: "bg-[#02569B] text-white",
    icon: Flutter,
  },
  DJANGO: {
    name: "Django",
    class: "bg-[#224336] text-white",
    icon: Django,
  },
  VUEJS: {
    name: "Vue Js",
    icon: Vue,
  },
  REACTJS: {
    name: "React Js",
    class: "bg-[#1c2c4c] text-white",
    icon: React,
  },
  ANDROID: {
    name: "Android",
    class: "bg-[#04242c] text-white",
    icon: Android,
  },
  IOS: {
    name: "iOS",
    class: "bg-white text-black",
    icon: Code,
  },
  FIREBASE: {
    name: "Firebase",
    class: "bg-[#1c2c4c] text-white",
    icon: Firebase,
  },
  SUPABASE: {
    name: "Supabase",
    class: "bg-[#1c2c4c] text-white",
    icon: Supabase,
  },
  GO: {
    name: "Go",
    class: "bg-[#00ADD8] text-white",
    icon: Code,
  },
};
const PROJECTS = [
  {
    title: "FinTrack Pro",
    description:
      '"FinTrack Pro" es una completa aplicación móvil para la gestión de las finanzas personales creada con Flutter, diseñada como un proyecto de cartera profesional para demostrar habilidades avanzadas de desarrollo móvil y experiencia en arquitectura de software. El proyecto evoluciona a lo largo de cuatro fases durante 32 meses (131 fines de semana), comenzando con un MVP básico y culminando en una aplicación lista para su producción publicada en App Store y Google Play.',
    github: "https://github.com/wdavid73/fin_track_pro",
    image: "/projects/fin_track_pro.png",
    tags: [TAGS.FLUTTER, TAGS.FIREBASE, TAGS.ANDROID, TAGS.IOS, TAGS.GO],
    link: "https://deepwiki.com/wdavid73/fin_track_pro",
  },
  {
    title: "Safe Lock",
    description:
      '"SafeLock" es un gestor de contraseñas encriptado que funciona sin conexión y protege tus credenciales con biometría, cifrado local AES256, y almacenamiento seguro. Ideal para mantener tu vida digital segura, con sincronización opcional entre dispositivos.',
    github: "https://github.com/wdavid73/safe_lock",
    image: "/projects/safe_lock.png",
    tags: [TAGS.FLUTTER, TAGS.FIREBASE],
    link: "https://deepwiki.com/wdavid73/safe_lock",
  },
  {
    title: "SmartScan",
    description:
      "SmartScan una aplicación móvil que permite escanear documentos físicos con calidad profesional desde tu cámara. Utiliza detección automática de bordes, mejora de imagen, OCR sin conexión y exportación a PDF, todo con una experiencia de usuario fluida, segura y offline-first.",
    github: "https://github.com/wdavid73/SmartScan",
    image: "/projects/smart_scan.png",
    tags: [TAGS.FLUTTER],
    link: "https://deepwiki.com/wdavid73/SmartScan",
  },
  {
    title: "Clima Link",
    description:
      "ClimaLink es tu conexión directa con el pronóstico del tiempo. Esta aplicación te proporciona información meteorológica actual y precisa para cualquier ciudad que elijas, mostrándote la temperatura, la descripción del clima y los iconos correspondientes de forma clara. Mantente siempre preparado para tu día sabiendo las condiciones climáticas exactas, desde la humedad hasta la velocidad del viento. Con ClimaLink, el pronóstico del tiempo está siempre a solo un toque de distancia, facilitando tu planificación diaria.",
    github: "https://github.com/wdavid73/clima_link",
    image: "/projects/clima_link.png",
    tags: [TAGS.FLUTTER],
    link: "https://deepwiki.com/wdavid73/clima_link",
  },
  {
    title: "Recipe Flow",
    description:
      "RecipeFlow es tu asistente culinario personal que simplifica la experiencia de cocinar. Con una interfaz intuitiva, puedes buscar rápidamente recetas por ingrediente o nombre, explorar una vasta colección y acceder a detalles claros como ingredientes, instrucciones paso a paso e imágenes apetitosas. Ya seas un chef experimentado o un principiante, RecipeFlow te guía sin esfuerzo a través del proceso de creación de platos deliciosos, haciendo que la preparación de tus comidas favoritas sea un verdadero placer.",
    github: "https://github.com/wdavid73/recipe_flow",
    image: "/projects/recipe_flow.png",
    tags: [TAGS.FLUTTER, TAGS.SUPABASE],
    link: "https://deepwiki.com/wdavid73/recipe_flow",
  },
  {
    title: "Klero App",
    description:
      "Klero App es una moderna aplicación de gestión de tareas desarrollada con Flutter. Permite a los usuarios organizar su día eficientemente, utilizando BLoC para el manejo de estado y Firebase para autenticación, sincronización en tiempo real y notificaciones. Destaca por su diseño intuitivo, gestión completa de tareas, soporte para modo oscuro/claro y manejo multi-idioma. Este proyecto demuestra experiencia en desarrollo móvil multiplataforma y backend.",
    github: "https://github.com/wdavid73/klero-app",
    image: "/projects/klero_app.png",
    tags: [TAGS.FLUTTER, TAGS.FIREBASE],
    link: "https://deepwiki.com/wdavid73/klero-app",
  },
  {
    title: "Flutter Starter Kit",
    description:
      "Este es un proyecto base en Flutter diseñado como plantilla para futuros desarrollos. Contiene configuraciones y paquetes esenciales para iniciar rápidamente nuevos proyectos.",
    github: "https://github.com/wdavid73/front_scaffold_flutter_v2",
    image: "/projects/flutter_starter_kit.png",
    tags: [TAGS.FLUTTER],
    link: "https://deepwiki.com/wdavid73/flutter_starter_kit",
  },
  {
    title: "Recipe Finder App",
    description:
      "App para buscar, compartir y crear recetas. Creada desde cero con Flutter y Django.",
    github: "https://github.com/wdavid73/recipe_finder_front",
    image: "/projects/recipe_finder.jpg",
    tags: [TAGS.FLUTTER, TAGS.DJANGO],
  },
  {
    title: "Poke App",
    description:
      "App desarrollada en Flutter y Django, utilizando el api PokeAPI, para mostrar una lista de pokemon por generacion.",
    github: "https://github.com/wdavid73/poke-app",
    image: "/projects/poke_app.jpeg",
    tags: [TAGS.FLUTTER, TAGS.DJANGO],
  },
  {
    title: "Confma",
    description:
      "Webapp desarrollada para el negocio Confecciones Maribel para gestionar este teniendo la lista de client, prendas alquidades y sin alquilar, etc. Creada desde cero con ReactJs, Django y cuenta con una version independiente en Android.",
    github: "https://github.com/wdavid73/confma_frontend",
    image: "/projects/confma.jpeg",
    tags: [TAGS.REACTJS, TAGS.DJANGO, TAGS.ANDROID],
  },
];
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, title, description, tags, github, link }) => (
      <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
        <div class="w-full md:w-1/2">
          <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
            <img
              alt="Recién llegado vs 5 años en Nueva Zelanda"
              class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
              loading="lazy"
              src={image}
            />
          </div>
        </div>

        <div class="w-full md:w-1/2 md:max-w-lg">
          <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
            {title}
          </h3>
          <div class="flex flex-wrap mt-2">
            <ul class="flex flex-row mb-2 gap-x-2">
              {tags.map((tag) => (
                <li>
                  <span
                    class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 `}
                  >
                    <tag.icon class="size-4" />
                    {tag.name}
                  </span>
                </li>
              ))}
            </ul>

            <div class="mt-2 text-gray-700 dark:text-gray-400">
              {description}
            </div>
            <footer class="flex items-end justify-start mt-4 gap-x-4">
              {github && (
                <LinkButton href={github}>
                  <GitHub class="size-6" />
                  Code
                </LinkButton>
              )}
              {link && (
                <LinkButton href={link}>
                  <Link class="size-4" />
                  Docs
                </LinkButton>
              )}
            </footer>
          </div>
        </div>
      </article>
    ))
  }
</div>
